# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never paste the values into the chat.

# Product name shown in the app (rename any time)
NEXT_PUBLIC_APP_NAME=ReelVALA

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to true only if Google sign-in isn't ready; data then stays in the browser
NEXT_PUBLIC_DEMO_MODE=false

# Server-only keys (used from M1 onwards)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the Claude model used for picks and copy
CLAUDE_MODEL=claude-sonnet-5-5
