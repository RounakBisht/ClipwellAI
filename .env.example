# Copy this file to .env.local for local development, or add the same names
# in Vercel → Project → Settings → Environment Variables. Never commit real values.

# Product name shown in the app
NEXT_PUBLIC_APP_NAME=ClipwellAI

# Public site URL, used for link previews and the sitemap
NEXT_PUBLIC_SITE_URL=https://clipwellai.vercel.app

# Supabase → Project Settings → API (the anon/public key only, never the service_role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true = no sign-in; projects are kept in this browser only
NEXT_PUBLIC_DEMO_MODE=false

# Server-only keys
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the Claude model used for picks and copy
CLAUDE_MODEL=claude-sonnet-5-5
